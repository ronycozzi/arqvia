{
  "name": "arqvia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run security:scan && npm run lint && npm run typecheck && npm run test && npm run content:check && npm run build",
    "verify:e2e": "playwright test --project=chromium --project=mobile && npm run test:e2e-residue",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e-residue": "tsx scripts/check-e2e-residue.ts",
    "e2e": "playwright test",
    "assets:pwa": "node scripts/generate-pwa-icons.mjs",
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "audit:public": "tsx scripts/audit-public-site.ts",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "security:scan": "tsx scripts/check-secrets.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:backfill:activity": "tsx scripts/backfill-lead-activity.ts",
    "db:backfill:leads": "tsx scripts/backfill-lead-identities.ts",
    "db:backfill:visits": "tsx scripts/backfill-technical-visits.ts",
    "db:backup:sqlite": "node scripts/backup-sqlite.mjs",
    "db:verify-restore:sqlite": "node scripts/verify-sqlite-restore.mjs",
    "db:cleanup:rate-limits": "tsx scripts/cleanup-rate-limits.ts",
    "db:postgres:schema": "node scripts/prepare-postgres-schema.mjs",
    "db:postgres:baseline": "npm run db:postgres:schema && node scripts/prepare-postgres-baseline.mjs",
    "db:postgres:generate": "npm run db:postgres:schema && prisma generate --schema prisma/postgresql/schema.prisma",
    "db:postgres:migrate": "npm run db:postgres:schema && prisma migrate dev --schema prisma/postgresql/schema.prisma",
    "db:postgres:deploy": "npm run db:postgres:generate && prisma migrate deploy --schema prisma/postgresql/schema.prisma && npm run db:backfill:activity && npm run db:backfill:leads && npm run db:backfill:visits",
    "build:postgres": "npm run db:postgres:generate && npm run content:check && next build",
    "build:release": "tsx scripts/build-production-release.ts",
    "db:push": "prisma db push",
    "db:init": "node scripts/init-sqlite.mjs",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "content:check": "tsx scripts/check-content-integrity.ts",
    "release:env": "tsx scripts/validate-environment.ts",
    "release:guard": "npm run release:env && npm run release:check",
    "ops:check": "tsx scripts/check-service-endpoints.ts",
    "release:check": "tsx scripts/check-release-readiness.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1119.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "next": {
      "postcss": "8.5.26"
    }
  }
}
